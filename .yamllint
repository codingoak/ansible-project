---
extends: default

rules:
  # Aligned columns in sysctl / auditd lists are intentional for readability
  commas:
    max-spaces-after: -1
  line-length: disable
  comments-indentation: disable
  comments:
    min-spaces-from-content: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  braces:
    max-spaces-inside: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
